  "fr": {
   "name": "Mega Man Battle Network 6 : Cybeast Falzar",
   "genre": "Jeu de rôles",
   "synopsis": "Même après avoir déménagé, Lan et son double Mega Man se retrouvent confrontés à une grande menace sur le réseau. Le jeu de rôle Mega Man Battle Network 6 sur GBA se décline en 2 versions (Cybeast Gregar et Cybeast Falzar) qui correspondent aux deux créatures impliquées dans le chaos qui se propage.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mega Man Battle Network 6 : Cybeast Falzar",
   "genre": "Role Playing Game",
   "synopsis": "In Mega Man Battle Network 6, Lan's father has received a job transfer and the family moves to Cyber City, a town known for conducting various technological experiments. Lan will meet new people and build new friendships in the real world while Mega Man befriends helpful Navis and encounters dangerous new enemies on the virtual plane. Together they will face threats far more powerful and perilous than they ever have before.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Raiden Fighters Jet",
   "genre": "Shoot'em up / Vertical",
   "synopsis": "Le troisième de la série Raiden Fighters. Cet opus conserve la même intensité et un gameplay maniaque que ses prédécesseurs, tout en introduisant plusieurs nouvelles mécaniques. Le jeu contient les modes de jeu Normal, Spécial et Expert. La bande originale se compose de musique rave et techno au rythme rapide, en rupture avec le style plus mélodique orienté pop de la série de jeux Raiden originale.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Raiden Fighters Jet",
   "genre": "Shoot'em Up / Vertical",
   "synopsis": "The third in the Raiden Fighters series. This opus retains the same intensity and manic gameplay as its predecessors, while introducing several new mechanics. The game contains Normal, Special, and Expert game modes.\r\n\r\nThe soundtrack consists of fast-paced rave and techno music in a departure from the more melodic pop orientated style of the original Raiden game series.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Eco Fighters",
   "genre": "Shoot'em up / Horizontal",
   "synopsis": "Dans un futur lointain, alors que la colonisation spatiale est très avancée, certaines entreprises n'hésitent pas à exploiter des planètes entières jusqu'à les détruire. Un scientifique célèbre, le Dr. Moly, met au point un vaisseau spatial dans le but de stopper les agissements néfastes de la plus grande multinationale du moment, la Goyolk, coupable de polluer sa planète.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Eco Fighters",
   "genre": "Shoot'em Up / Horizontal",
   "synopsis": "Eco Fighters is a horizontal shooter, where the player controls a ship with a rotating gun. As suggested by both its titles, the game has an \"eco-friendly\" theme. It was also developed by the same team from two Mega Man arcade titles, The Power Battle and The Power Fighters.",
   "synopsis_lang": "en"
  }
 },

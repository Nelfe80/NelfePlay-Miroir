  "fr": {
   "name": "Yu Yu Hakusho : Makyou Toitsusen",
   "genre": "Combat",
   "synopsis": "Yu Yu Hakusho est basé sur la série d'animes et le manga du même nom. Il raconte l'histoire d'un ado délinquant, Yuusuke Urameshi, qui se fait tuer par une voiture alors qu'il allait sauver un enfant. Malheureusement, il ne reste plus de place pour lui ni en enfer, ni au paradis, et c'est sur Terre qu'il est envoyé pour lutter contre les démons, dans un jeu de combat où 11 personnages de la série sont jouables.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Yu Yu Hakusho : Makyou Toitsusen",
   "genre": "Fighting",
   "synopsis": "Yusuke Urameshi and his friends are invited to a tournament by Makyou Toitsusen, a mysterious martial arts society. In this tournament they are gonna face again some demons who fought them in the past, and decide who are the strongest.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Samurai Shodown! 2 - Pocket Fighting Series",
   "genre": "Combat / Versus",
   "synopsis": "Une des séries de jeux de combat légendaires de SNK a fait son grand retour! Dans Samurai Shodown II, vous pouvez jouer l'un des rôles de 15 guerriers alors que vous vous frayez un chemin à travers le pays pour vaincre le méchant Mizuki! Entaillez et coupez vos adversaires en deux.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Samurai Shodown II",
   "genre": "Fighting / Versus",
   "synopsis": "One of SNK's legendary fighting game series has made a return! In Samurai Shodown II, you can take on one of the roles of 15 warriors as you fight your way through the land to defeat the evil Mizuki! Slash, kick, and slice your opponents in half...do whatever it takes...live by the sword, and die by its blade.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Ikari III - The Rescue",
   "genre": "Tir",
   "synopsis": "Fans de Rambo, bonjour (amis du bon goût, au revoir )! Vous aimez l'armée? Les mecs viriles à la Rambo qui dégoulinent de sueur un couteau à la main? Alors ce jeu essentiellement basé Arcade est fait pour vous. Egorgez, étripez, l'ennemi ne doit pas survivre dans des millieux divers comme un fleuve, une route, des hangars... Garde à vous!",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Ikari III - The Rescue",
   "genre": "Shooter",
   "synopsis": "Two shirtless Rambo-type players fight their way behind enemy lines to rescue a kidnapped hostage. Various military types must be killed by fist, knife, foot or gun. The players are occasionally marauded by tanks and",
   "synopsis_lang": "en"
  }

 "text": {
  "fr": {
   "name": "Super Pac-Man",
   "genre": "Action / Labyrinthe",
   "synopsis": "Pac-Man doit manger des clés pour ouvrir des portes, ce qui lui permettra de manger des fruits et des prix, pas des points. Manger le Super Power Energizers augmente la taille de Pac-Man et lui permet d'accélérer. Pendant toute la durée de ce Super énergisant, il peut passer librement au-dessus des fantômes, même si ce sont leurs couleurs dangereuses d'origine.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Super Pac-Man",
   "genre": "Action / Labyrinth",
   "synopsis": "Super Pac-Man is a 1- or 2-player game where you are in control of the legendary Pac-Man. As in the original \"Pac-Man\" game, the goal is to clear each maze, but this time, instead of dots, the maze consists of prizes which are locked away behind gates. There are two ways to access the prizes. You can eat the keys which open a particular gate, and not always the gate which is closest to that key. Or you can crash through the gate after you eat a Super Pill and become Super Pac-Man. You are not required to eat all of the keys in order to complete the stage.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Neo Geo Cup '98 : The Road to the Victory",
   "genre": "Sport",
   "synopsis": "Neo Geo Cup'98 est une simulation de football basée sur la coupe du Monde 1998. Ce titre est un nouvel opus de la série Super Sidekicks et met à jour l'ensemble des données pour se concentrer sur l'événement. En phase de qualification ou lors des matchs à élimination directe, menez l'une des 64 équipes disponibles vers la victoire.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Neo Geo Cup '98 : The Road to the Victory",
   "genre": "Sports",
   "synopsis": "Neo Geo Cup'98 is a football simulation based on the World Cup 1998. This title is a new installment in the series Super Sidekicks and updates all data to focus on the event. In qualification phase or during games knockout, lead one of the 64 available teams to victory.",
   "synopsis_lang": "en"
  }
 },

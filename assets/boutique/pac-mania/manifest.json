  "fr": {
   "name": "Pac-Mania",
   "genre": "Action / Labyrinthe",
   "synopsis": "Une version 3-D du classique original. Un bouton de rebond permet à Pac-Man de sauter par-dessus les fantômes. De plus, il y a plus de fantômes, dont certains ont la capacité de sauter chaque fois que Pac-Man saute.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Pac-Mania",
   "genre": "Action / Labyrinth",
   "synopsis": "Pac-Mania is a 1- or 2-player game in which the player maneuvers Pac-Man through a world of 3-D mazes. He's back in action... but with a new twist, BOUNCE power! Ready for a new generation of Pac-Man players, he can't wait",
   "synopsis_lang": "en"
  }
 },

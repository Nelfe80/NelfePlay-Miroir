  },
  "en": {
   "name": "Böbl",
   "genre": "Platform",
   "synopsis": "You're a bubble, water is your friend and solid tiles kill you. Hold A to dive, then release and let buoyancy handle the rest. Let's find all the lost duckies!",
   "synopsis_lang": "en"
  }
 },

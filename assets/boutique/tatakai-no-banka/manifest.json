 "text": {
  "fr": {
   "name": "Trojan",
   "genre": "Plateforme",
   "synopsis": "Trojan est beat'em up découpé en six niveaux, dans lesquels le joueur affronte une série de petites frappes, un mini-boss au milieu de chaque niveau, et un boss à la fin. Le joueur peut débuter la partie à n'importe quel niveau, mais doit terminer l'ensemble des niveaux deux fois pour voir la \"vraie\" fin, comme dans Ghosts'n Goblins). Le joueur peut continuer la partie ou non après un game over, en fonction des réglages des interrupteurs DIP.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Trojan",
   "genre": "Platform",
   "synopsis": "The game consist of six stages, where the player will face the usual series of small fry enemies, as well as a sub-boss at the middle of each stage and a boss at the end. The player is allowed to start the game at any of the six stages. However, the player must play through the entire game again after defeating the final boss, Achilles, in order to see the true ending (similarly to Ghosts'n Goblins). The player can continue after a game over depending on the dip switch settings.",
   "synopsis_lang": "en"
  }
 },

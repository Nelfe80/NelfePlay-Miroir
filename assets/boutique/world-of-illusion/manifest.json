 "text": {
  "fr": {
   "name": "World of Illusion Starring Mickey Mouse and Donald",
   "genre": "Plateforme",
   "synopsis": "Alakazam! Et revoici les inoubliables aventures de Disney avec vos amis Mickey Mouse et Donald Duck. Transportés vers un monde de fantaisie, Mickey et Donald doivent accomplir d'étonnantes prouesses de magie pour vaincre un Sorcier habile et retrouver le chemin de leur maison!",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "World of Illusion Starring Mickey Mouse and Donald Duck",
   "genre": "Platform",
   "synopsis": "World of Illusion is sort of a follow-up to Castle of Illusion. Mickey Mouse and Donald Duck are taken to a magic world and have to get back home. In order to do that, they can play magical tricks and interact to each other in a 2-player mode. Like other Disney games for SEGA consoles of the same period, the game has cartoon-like graphics and is played as a side-scrolling platformer.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Video Pinball : Arcade Pinball",
   "genre": "Flipper",
   "synopsis": "Video Pinball pour Atari VCS 2600 est un jeu de flipper développé par Atari. Le jeu reprend le principe d'un flipper. Le but est de gagner un maximum de points. Il y a deux niveaux de difficulté et 4 modes de jeu.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Video Pinball : Arcade Pinball",
   "genre": "Pinball",
   "synopsis": "Video Pinball is a pinball simulation for one or two players. You begin the game with three balls and need to score as many points as possible by hitting the various bumpers, spinners, and rollovers on the pinball table. An extra ball can be earned by hitting the Atari logo rollover four times in a row!  There are two difficulty levels and four game variations included.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Ikari III : The Rescue",
   "genre": "Beat'em All",
   "synopsis": "Ikari III : The Rescue est un jeu d'action sur Nes. Dans ce troisième opus de la série des Ikari Warriors la fille du président a été capturée et c'est à vous qu'incombe la tâche de traverser les lignes ennemies pour la sauver. Vous commencez le jeu à mains nues mais vous trouverez de nombreuses armes au cours de la partie.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Ikari III : The Rescue",
   "genre": "Beat'em Up",
   "synopsis": "The presidential candidate's daughter has been kidnapped! It is your job to get past enemy lines and rescue her. This is the third game in the Ikari Warriors series, and features similar arcade/action gameplay. The screen is a top down view which scrolls vertically, with numerous bad guys to defeat. You start the game with just your fists, and as the levels progress you can find weapons and other objects to help you out.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Baseball Stars Color",
   "genre": "Sport / Baseball",
   "synopsis": "Baseball Stars Color est un jeu de sport sur le baseball. Le jeu est semblable à Baseball Stars de NES mais a des personnages et un gameplay moins réalistes. Vous gérez votre propre équipe de baseball et jouez des série de matchs. Le jeu a les règles typiques du baseball - un joueur jette le ballon, le deuxième frappe la balle, quelqu'un l'attrape, etc. Chaque personnage a ses propres statistiques.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Baseball Stars Color",
   "genre": "Sports / Baseball",
   "synopsis": "Baseball Stars Color is sports game about baseball. Game is similar to Baseball Stars from NES but has less realistic characters and gameplay's style. You manage own baseball team and play in series of matches. Game has typical baseball rules - one player throws the ball, second hits the ball, someone else grabs it etc. Each character has own statistics",
   "synopsis_lang": "en"
  }
 },

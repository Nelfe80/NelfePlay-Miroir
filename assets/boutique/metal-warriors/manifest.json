 "text": {
  "fr": {
   "name": "Metal Warriors",
   "genre": "Plateforme",
   "synopsis": "Metal Warriors est un jeu de plates-formes développé par Lucas Arts et édité par Konami sur Super Nintendo. Alors qu'en 2102 le gouvernement uni de la Terre est attaqué par l'axe de l'ombre, les hommes décident de s'équiper d'armures intelligentes et mécaniques pour défendre la Terre ! Le jeu propose un mode multijoueur.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Metal Warriors",
   "genre": "Platform",
   "synopsis": "Get deployed in your own giant mech and battle through nine linear levels against the evil Dark Axis forces. Eject and switch robots, piloting one of the six \"Battledroid\" suits; but watch out because there are no save games and no continue codes.\n\nFor the best of Metal Warriors, grab a friend for some head-to-head combat in the PvP mode. The variety of robots and levels means the matchups stay surprising and interesting.",
   "synopsis_lang": "en"
  }
 },

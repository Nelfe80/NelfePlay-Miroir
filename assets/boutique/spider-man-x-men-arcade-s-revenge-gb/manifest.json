 "text": {
  "fr": {
   "name": "Spider-Man - X-Men - Arcade's Revenge",
   "genre": "Plateforme",
   "synopsis": "Spider-Man and the X-Men : Arcade's Revenge est un jeu d'action/plate-formes sorti sur Game Boy en 1994.\nOn a plaisir à prendre en main les différents super-héros. Ceux-ci offrent d'ailleurs des pouvoirs bien diversifiés. Malheureusement, l'absence de points de sauvegarde et le nombre limité de vies entachent le tout.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Spider-Man - X-Men - Arcade's Revenge",
   "genre": "Platform",
   "synopsis": "Spider-Man and his mutant pals need your help to escape from Arcade's diabolical amusement park - battling killer clowns, hungry piranhas, lethal doom balls and deadly robot replicas of super-villains like Carnage and Juggernaut! Will Spidey's webs, Wolverine's claws, Gambit's energy cards, Storm's lightning bolts and Cyclops' optic blasts mean GAME OVER for Arcade? That depends on YOU!!",
   "synopsis_lang": "en"
  }
 },

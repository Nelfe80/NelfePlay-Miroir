 "text": {
  "fr": {
   "name": "Samurai Shodown II",
   "genre": "Combat / Versus",
   "synopsis": "Samurai Shodown II sur Neo Geo est un jeu de combat se déroulant au Moyen-Age au coeur du pays du soleil levant. Pour ce second opus de la série, 16 combattants s'affrontent et font part de leur talent en ce qui concerne l'usage d'armes blanches. Enchaînez les combos pour faire monter votre jauge de Pow et lancer une attaque fatale.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Samurai Shodown II",
   "genre": "Fighting / Versus",
   "synopsis": "One of SNK's legendary fighting game series has made a return! In Samurai Shodown II, you can take on one of the roles of 15 warriors as you fight your way through the land to defeat the evil Mizuki! Slash, kick, and slice your opponents in half...do whatever it takes...live by the sword, and die by its blade.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Mega Man Battle Network 5 : Team ProtoMan",
   "genre": "Jeu de rôles",
   "synopsis": "Le Dr. Regal et son syndicat du crime Nebula sont de retour sur le réseau. Lan doit donc réactiver son Navi Mega Man pour débarrasser le monde virtuel de ses virus. Le jeu de rôle Mega Man Battle Network 5 sur GBA se décline en deux versions (Team ProtoMan et Team Colonel) qui diffèrent légèrement l'une de l'autre par les pouvoirs que le héros peut accueillir.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mega Man Battle Network 5 : Team ProtoMan",
   "genre": "Role Playing Game",
   "synopsis": "Team Protoman is the first edition of Mega Man Battle Network 5. In the game, you can join forces with characters from previous installments of the Mega Man Battle series, and you can play in a new fighting mode. Team up with other cyberheroes in an effort to stop an evil organization from taking control of the global Internet.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Bogey Blaster",
   "genre": "Tir / Véhicule, 1ere personne",
   "synopsis": "Un simple jeu de simulateur de vol. Tirez sur les avions, évitez les tirs d'artillerie. Vous avez une quantité limitée de munitions et de carburant. Tirez sur 10 avions et vous pourrez atterrir pour faire le plein, mais vous risquez de perdre des munitions. On ne vous donnera que la quantité de munitions que vous avez utilisée avec succès pour abattre des avions la dernière fois.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Air Raiders",
   "genre": "Shooter / Vehicle, FPV",
   "synopsis": "A simple flight simulator and dogfighting game. Shoot the planes, avoid the flak. You have a limited amount of ammuntion and fuel. Shoot down 10 planes and you can land to refuel, but you may lose ammo. You'll only be given as much ammunition as you successfully used to shoot down planes the last time up.",
   "synopsis_lang": "en"
  }
 },

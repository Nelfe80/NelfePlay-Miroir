 "text": {
  "fr": {
   "name": "Ghost Pilots",
   "genre": "Shoot'em up / Vertical",
   "synopsis": "Ghost Pilots sur Neo Geo est un shoot'em up se déroulant durant la Seconde Guerre mondiale. Le joueur dirige un bombardier et peut tirer sur ses adversaires ou lâcher des bombes limitées en nombre. Les tirs peuvent augmenter en puissance à condition de récupérer des bonus estampillés S, lâchés par un groupe d'avions rouges. Gardez un oeil partout car les tirs et avions ennemis proviennent des quatre coins de l'écran.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Ghost Pilots",
   "genre": "Shoot'em Up / Vertical",
   "synopsis": "Ghost Pilots is an overhead military plane shooter, in which you must shoot down fighter jets by either using bullets or bombs. Once you have killed enough fighter jets, you will have to defeat a boss fighter jet in order to continue. After some stages, you must select a route to continue your journey on. Power-ups can be collected that will increase your firepower, and stars can be obtained for extra points.",
   "synopsis_lang": "en"
  }
 },

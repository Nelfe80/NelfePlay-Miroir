 "text": {
  "fr": {
   "name": "Marvin's Maze",
   "genre": "Action / Labyrinthe",
   "synopsis": "Un jeu de labyrinthe où vous affrontez les Robonoïds tout en essayant de récupérer toutes les pastilles. Deux façons de terminer un niveau : ramasser toutes les pastilles ou atteindre le nombre de Robonoïds à détruire indiqué en bas de l'écran. Pour détruire un Robonoïd : tirer dessus ou faire un trou sous lui à certains endroits du labyrinthe.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Marvin's Maze",
   "genre": "Action / Labyrinth",
   "synopsis": "A maze game where you fight against Robonoids while trying to clear the maze of dots. Two ways to finish each rack: Eat up all the dots, or destroy a certain number of Robonoids (listed at the bottom of the screen). Two ways to destroy the Robonoids: Shoot them, or remove the ground from under them at certain points of the maze (the 'Trick').",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Fight for Life",
   "genre": "Combat",
   "synopsis": "Fight for Life sur Jaguar est un jeu de combat en trois dimensions dans lequel vous pouvez incarner un ancien combattant défunt qui veut s'échapper des enfers et retourner dans le monde des vivants. Huit personnages sont disponibles, il vous faut ensuite battre tous vos adversaires, sachant qu'à chaque victoire, vous obtenez deux mouvements de votre concurrent.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Fight for Life",
   "genre": "Fighting",
   "synopsis": "Fight for Life is a 3D fighting game that takes place in hell.  The player controls one of eight deceased fighters competing to earn a chance to escape and return to the world of the living. After they defeat an opponent they not only move on to the next round, but also learn two of the opponent's moves.\n\nThis is the only 3D fighting game released for the Jaguar.  It features brightly-colored texture mapped fighters and arenas. Gameplay is very similar to Virtua Fighter, in that the moves more-or-less look like real martial arts.",
   "synopsis_lang": "en"
  }
 },

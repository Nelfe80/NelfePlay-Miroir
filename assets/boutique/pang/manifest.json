 "text": {
  "fr": {
   "name": "Pang",
   "genre": "Tir",
   "synopsis": "Pang est un jeu vidéo d'action-réflexion.\r\nUn ou deux joueurs se déplace(nt) dans un tableau où rebondissent des boules géantes. Il est possible d'éclater ces boules à l'aide de grappins ou d'autres armes récoltées en cours de jeu. Les boules se divisent alors en 2 boules plus petites, et ainsi de suite jusqu'à leur destruction complète.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Buster Bros.",
   "genre": "Shooter",
   "synopsis": "One or two players control safari-suited characters armed with harpoon guns, who must destroy the numerous different-sized balloons that litter each stage. When hit by a harpoon, the balloons break down into smaller fragments.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "WWF Wrestlefest",
   "genre": "Sport / Combat",
   "synopsis": "WWF WrestleFest est un jeu d'arcade de catch professionnel développé et commercialisé par Technos en 1991, mettant en scène les superstars de la société américaine World Wrestling Federation.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "WWF Wrestlefest",
   "genre": "Sports / Fighting",
   "synopsis": "WWF WrestleFest is the sequel to the 1989 arcade game WWF SuperStars and is based on the World Wrestling Federation allowing you to control famous wrestlers from the late 80s like Hulk Hogan, Ultimate Warrior and Earthquake. Whereas SuperStars only let you compete in Tag-Team, WrestleFest allows you to compete in the Battle Royal: Royal Rumble as well as Saturday Nights Main Event: Tag Match.",
   "synopsis_lang": "en"
  }
 },

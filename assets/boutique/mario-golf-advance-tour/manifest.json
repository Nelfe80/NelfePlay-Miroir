  "fr": {
   "name": "Mario Golf : Advance Tour",
   "genre": "Sport / Golf",
   "synopsis": "Jouez au golf avec le célèbre Mario accompagné de toute sa bande dans Mario Golf : Tour Advance. Cet opus  sur Gameboy Advance se compose de plusieurs parcours, de nombreux modes de jeu et de différents personnages jouables pour des heures de plaisir seul ou entre amis, via le système link.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mario Golf : Advance Tour",
   "genre": "Sports / Golf",
   "synopsis": "Grab your clubs and start down the road to golfing perfection in this role-playing golf adventure! Chat up the locals at golf clinics, hone your skills in challenges like Club Slots and Go-Go Gates, and try to become the champ of all the country clubs! The Mushroom Kingdom residents take on only the very best.",
   "synopsis_lang": "en"
  }
 },

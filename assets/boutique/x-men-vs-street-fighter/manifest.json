 "text": {
  "fr": {
   "name": "X-Men vs. Street Fighter",
   "genre": "Combat",
   "synopsis": "Le début d'un mythe. Si X-Men vs Street Fighter est le premier cross-over à voir le jour, on ne sera pas étonné que la recette soit reprise tant de fois par la suite. Et pour preuve, ce premier titre est resté dans les mémoires comme étant un incontournable.Sorti donc en 1997 seulement au Japon dans une belle boîte cartonnée avec la RAM de 4 Mb qui va donner son potentiel explosif au jeu, X-Men vs Street Fighter est certainement le cross-over par excellence de la console, qui nous le restitue une fois encore dans une version parfaitement identique à l'arcade.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "X-Men vs. Street Fighter",
   "genre": "Fighting",
   "synopsis": "X-Men vs. Street Fighter pits Marvel's mighty mutants against Capcom's legendary fighters in a slugfest of epic proportions. Now you can perform outrageous moves and link together amazing Chain Combos. X-Men vs. Street Fighter... the collision of two explosive universes in the world's most amazing fantasy fighter!",
   "synopsis_lang": "en"
  }
 },

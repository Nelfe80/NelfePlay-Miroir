 "text": {
  "fr": {
   "name": "Surround",
   "genre": "",
   "synopsis": "Surround est un jeu d'arcade sorti sur Atari VCS 2600. Chaque joueur contrôle un serpent et gagne des points lorsque l'autre joueur lui fonce dessus.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Surround : Chase",
   "genre": "",
   "synopsis": "Welcome to the exciting and competitive world of SURROUND. Your basic objective is to surround your opponent, causing him to run out of space in which to move, and at the same time not running into anything yourself. You can set up a blockade, force him into a corner or wander off by yourself and hope that he runs into something on his own.\r\n\r\nAlong with the basic SURROUND game, we've added four game features to make things more interesting. Be sure to read Section 4 to learn more about these features.\r\n\r\nThen there's VIDEO GRAFFITI. It's just for fun without the competitive edge thrown in. VIDEO GRAFFITI actually allows you to draw on the screen.\r\n\r\nSurround was one of the nine Atari 2600 launch titles released in September 1977.",
   "synopsis_lang": "en"
  }
 },

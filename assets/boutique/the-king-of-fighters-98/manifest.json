  "fr": {
   "name": "The King of Fighters '98",
   "genre": "Combat / Versus",
   "synopsis": "The King of Fighters'98 est un jeu de combat 2D sur Wii. Cinquième opus de la série, ce volet intitulé au Japon \"Dream Match Never Ends\" se déroule en réalité à l'intérieur d'un rêve du personnage Shingo. Le joueur a le choix d'incarner 36 combattants différents.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "The King of Fighters '98",
   "genre": "Fighting / Versus",
   "synopsis": "The King of Fighters'98 is a 2D fighting game for Wii. Fifth opus of the series, this part titled \"Dream Match Never Ends\" in Japan actually takes place inside a dream reality of the character Shingo. The player has the choice of controlling 36 different fighters.",
   "synopsis_lang": "en"
  }

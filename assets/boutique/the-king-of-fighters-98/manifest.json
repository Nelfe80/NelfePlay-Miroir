 "text": {
  "fr": {
   "name": "The King of Fighters '98 : The Slugfest",
   "genre": "Combat",
   "synopsis": "The King of Fighters'98 est un jeu de combat 2D sur NEO GEO. Cinquième opus de la série, ce volet intitulé au Japon \"Dream Match Never Ends\" se déroule en réalité à l'intérieur d'un rêve du personnage Shingo. Le joueur a le choix d'incarner 36 combattants différents.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "The King of Fighters '98 : The Slugfest",
   "genre": "Fighting",
   "synopsis": "For all you King of Fighters fans, SNK offers the ultimate KOF installment! A total of 38 of your favorite fighters from all the characters appearing in the '94 to '97 versions. The nostalgic American Sports team, Lugal, as well as Heidern, Takuma, Saishu Kusanagi and other long-awaited characters are back! The ultimate reunion is about to begin in The King of Fighters '98!",
   "synopsis_lang": "en"
  }
 },

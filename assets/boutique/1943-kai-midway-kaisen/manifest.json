  "fr": {
   "name": "1943 Kai : Midway Kaisen",
   "genre": "Shoot'em up / Vertical",
   "synopsis": "Troisième jeu de la série des 1940.\r\nIl s'agit en réalité d'une mise à jour de \"1943 : The Battle of Midway\" avec pour différences des armes améliorées, moins de niveaux, une nouvelle bande-son et une difficulté accrue.\r\nL'avion que vous pilotez n'est pas votre P-38 régulier mais un biplan Boeing Stearman. Les sprites des ennemis ont aussi été modifiés.\r\nCette mise à jour n'est sortie uniquement que dans les salles d'arcade au Japon.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "1943 Kai : Midway Kaisen",
   "genre": "Shoot'em Up / Vertical",
   "synopsis": "An update of 1943 with tweaked weapons, fewer levels, and a new soundtrack.",
   "synopsis_lang": "en"
  }
 },

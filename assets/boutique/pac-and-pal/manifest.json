 "text": {
  "fr": {
   "name": "Pac & Pal",
   "genre": "Action / Labyrinthe",
   "synopsis": "Dans cette suite, Pac-Man ouvre les portes en retournant les cartes. Au lieu des pilules à moteur, Pac-Man assume les pouvoirs de deux cibles spéciales par tour. Les parties bonus consistent à retourner le plus de cartes possible avant de trouver le monstre rouge",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Pac & Pal",
   "genre": "Action / Labyrinth",
   "synopsis": "Pac-Man has a new friend named Miru, but she tries to steal stuff and take it to the ghost pen. Pac-Man now not only has to collect the stuff lying around the board, but he must also watch Miru to make sure she doesn't take the stuff for her own use.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Sonic Drift",
   "genre": "Course, Conduite",
   "synopsis": "Sonic Drift sur Game Gear met en scène Sonic, Tails, Amy et Robotnik dans des courses de voitures. Vous avez le choix entre six circuits, issus des environements du jeu de plates-formes, chacun avec trois niveaux de difficulté.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Sonic Drift",
   "genre": "Racing, Driving",
   "synopsis": "Sonic Drift is a Sonic the Hedgehog racing game. The evil Dr. Robotnik has stolen the chaos emeralds and you have to win them back in a racing tournament. In Sonic Drift, you can play as Sonic, Tails, Amy, or Robotnik. Sonic Drift can also be found on Sonic Adventure DX and Sega Mega Collection Plus. There are six levels in each game and three different  tournaments, totaling 18 levels.",
   "synopsis_lang": "en"
  }
 },

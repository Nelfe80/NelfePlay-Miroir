 "text": {
  "fr": {
   "name": "Super Contra",
   "genre": "Shoot'em up / Horizontal",
   "synopsis": "Un an après, l'organisation Red Falcon revient pour prendre sa revanche... Lance et Bill reprennent donc du service pour mettre un terme à la menace. Les armes à disposition du joueur ont changé : mitrailleuse, lance-grenades et laser en plus du fusil d'assaut de base. Au rayon des niveaux, il y a un changement de taille : les passages dans les souterrains avec une vue de dos du héros du premier sont remplacés par une vue de dessus. Le saut est remplacé par une grosse bombe à ramasser nettoyant l'écran.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Super Contra",
   "genre": "Shoot'em Up / Horizontal",
   "synopsis": "A year after the battle with the Red Falcon organization, Bill and Lance are sent on another mission. This time, the alien forces have taken over an allied military base somewhere in Africa, possessing most of its troops. Bill and Lance must not only fight against their former comrades-in-arms, but also a new mutated form of the same alien creatures they fought during their previous mission.",
   "synopsis_lang": "en"
  }
 },

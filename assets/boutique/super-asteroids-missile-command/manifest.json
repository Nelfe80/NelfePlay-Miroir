 "text": {
  "fr": {
   "name": "Super Asteroids & Missile Command",
   "genre": "Compilation",
   "synopsis": "Super Asteroids & Missile Command sur Lynx regroupe deux grands classiques de l'arcade made in Atari et remis à jour pour cette compilation. Dans cette version, les deux titres contiennent des fonctions améliorées afin de justifier le \"Super\" du titre.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Super Asteroids & Missile Command",
   "genre": "Compilation",
   "synopsis": "Two classic Atari arcade games were updated for this compilation. This Lynx version of Asteroids and Missile Command contains some enhanced features to justify the \"super\" in the title.\r\n\r\nSuper Asteroids has all new graphics to replace the vector outlines of the original. Your ship has a shield that can absorb several collisions before it blows up. There are also power ups to increase your firepower.\r\n\r\nSuper Missile Command also has all new graphics. Between rounds, you can trade credits earned during gameplay to purchase special weapons that will help you later in the game.",
   "synopsis_lang": "en"
  }
 },

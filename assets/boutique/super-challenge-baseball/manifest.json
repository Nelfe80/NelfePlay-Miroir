 "text": {
  "fr": {
   "name": "Super Challenge Baseball",
   "genre": "Sport / Baseball",
   "synopsis": "Le but du jeu est de marquer le plus de points en 9 manches ou plus. La plupart des règles de baseball professionnel s'appliquent : 3 frappes pour un retrait, 4 balles pour une promenade, les 2 premières balles incriminées comptent pour des frappes. Chaque joueur contrôle une équipe de 8 personnes. Une équipe est sur le terrain pendant que l'autre équipe est au bâton",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Super Challenge Baseball",
   "genre": "Sports / Baseball",
   "synopsis": "The object of the game is to score the most runs in 9 innings or extra innings to a decision. Most professional baseball rules apply - 3 strikes for an out, 4 balls for a walk, first 2 fouled balls count as strikes. Each player controls an 8-man team. One team fields while the other team is up to bat. Home runs, force-outs, double and triple plays can all be made. Batter up!",
   "synopsis_lang": "en"
  }
 },

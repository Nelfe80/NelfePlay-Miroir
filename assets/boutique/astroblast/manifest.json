 "text": {
  "fr": {
   "name": "Astroblast",
   "genre": "Tir",
   "synopsis": "Astrosblast est un jeu vidéo conçu par John Sohl et commercialisé par Mattel Electronics en 1981. Le jeu consiste à utiliser un canon laser pour détruire les météores, les bombes et autres cibles.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Astroblast",
   "genre": "Shooter",
   "synopsis": "For 1 player at a time- compete with friends for the best peak score! 2 firing modes- 2 speed options. Shoot down a variety of fast-moving targets: falling meteors, spinning bombs, guided missiles- even a bomb-dropping UFO! The computer keeps score, and gives you more challenging game action the higher you go!\r\n\r\nThis is the Atari version of the Intellivision game Astrosmash. There is a bug in the original release of this cartridge - when two controllers are plugged in and moved simultaneously, unpredictable graphic effects can occur, and the joysticks may stop operating until the game is reset. The bug was fixed in later productions of the game.",
   "synopsis_lang": "en"
  }
 },

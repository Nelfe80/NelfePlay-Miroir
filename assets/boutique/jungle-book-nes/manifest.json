    "text": {
        "fr": {
            "name": "Le Livre de la Jungle",
            "genre": "Plateforme",
            "synopsis": "Le Livre de la Jungle sur NES est l'adaptation du film de Disney de 1967, lui-même inspiré du livre écrit par Rudyard Kipling. Vous incarnez Mowgli et devez ramasser des fruits, grimper aux arbres et combattre les ennemis de l'histoire comme Sher Khan. Le jeu permet de replonger dans l'univers d'un des classiques de Disney en retrouvant tous ses personnages et ses décors.",
            "synopsis_lang": "fr"
        },
        "en": {
            "name": "The Jungle Book",
            "genre": "Platform",
            "synopsis": "Get down to the bare necessities of life... and escort Mowgli through the jungle to the safety of the human village. Fight the boggle-eyed snake, Kaa, and defeat Shere Khan the hungry tiger in this exciting adventure based on Disney's classic! It'll drive you ape crazy!",
            "synopsis_lang": "en"
        }
    },

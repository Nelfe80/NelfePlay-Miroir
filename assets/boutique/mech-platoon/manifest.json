  "fr": {
   "name": "Mech Platoon",
   "genre": "Tir",
   "synopsis": "Mech Platoon est un jeu d'action/stratégie sur Gameboy Advance. Dans un futur lointain, les robots ont remplacé les fantassins humains. Vous devez choisir votre camp parmi 3 forces aux caractéristiques différentes : les troupes Léon, les Monos et les Trampler.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mech Platoon",
   "genre": "Shooter",
   "synopsis": "A real-time strategy (RTS) game for the GBA.  Players build an army of robot mechs to capture 5 planets in a series of missions against two other nations.  A player's mechs are built and improved by building laboratories, bases and by salvaging battlefields for enemy parts.  All the key elements of a classic RTS in your GBA.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Malibu Bikini Volleyball",
   "genre": "Sport / Volleyball",
   "synopsis": "Malibu Bikini Volleyball est un jeu de sport sur Lynx. Vous êtes aux commandes d'une équipe de jolies filles assez dénudées qui luttent courageusement pour le titre de championnes de volley. Mais attention, ne vous laissez pas distraire par des Bikinis et concentrez-vous plûtot sur votre seul objectif : la victoire !",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Malibu Bikini Volleyball",
   "genre": "Sports / Volleyball",
   "synopsis": "Welcome to Malibu: Volleyball capital of the world. This is where the best come to play--and show off their tans. If you want in, sign up. But keep your eyes on the ball...there'll be plenty of time for bikini-watching after the match!",
   "synopsis_lang": "en"
  }
 },

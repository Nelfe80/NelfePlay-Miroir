 "text": {
  "fr": {
   "name": "Warbirds",
   "genre": "Simulation",
   "synopsis": "Warbirds est une simulation d'aviation disponible sur Lynx. Ce jeu peut se jouer en multijoueur avec 3 amis ou hors ligne dans de nombreuses missions. Plusieurs arènes ainsi que différents avions sont disponibles avec chacun leurs caractéristiques de pilotage propres. Le jeu prend place durant la Première Guerre mondiale.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Warbirds",
   "genre": "Simulation",
   "synopsis": "A combat flight action/simulation with colorful graphics and pretty straight-forward gameplay.\n\nStep inside the cockpit of a World War I plane, when there were no sophisticated weaponry, and try to gun down the enemy. Simple as that.\n\nThe graphics were faux-3D, as the planes were 2D sprites (natural, considering the release date), but the sky seemed very vast and you could fly around freely.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Sonic The Hedgehog 2",
   "genre": "Plateforme",
   "synopsis": "Sonic est de retour et meilleur que jamais. Il est absolument super! Il déborde d'énergie! Sa nouvelle super attaque éclair est extraordinaire, comme son nouvel ami, \"Tails\", le renard. Vous n'en croierez pas vos yeux. Et, pris par le feu de l'action, vous ne lâcherez plus les commandes.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Sonic The Hedgehog 2",
   "genre": "Platform",
   "synopsis": "Sonic the Hedgehog 2 continues Sonic's fast-paced adventures and introduces his loyal sidekick Tails. You dash through diverse zones, collecting rings that serve as both protection and extra lives, and face Robotnik's machines at each zone's end. Reaching a checkpoint with enough rings unlocks the Special Stage, where you race through a half-pipe to gather Chaos Emeralds. New to the game is the Spin Dash – a quick burst of speed from a standstill, perfect for slopes and tricky areas. You can play solo or cooperatively with Tails, who has infinite lives and always stays close. There's also a versus mode where you race a friend through specially designed split-screen levels.",
   "synopsis_lang": "en"
  }
 },

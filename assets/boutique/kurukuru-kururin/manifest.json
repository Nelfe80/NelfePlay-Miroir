 "text": {
  "fr": {
   "name": "Kurukuru Kururin",
   "genre": "Action / Labyrinthe",
   "synopsis": "Kuru Kuru Kururin est un jeu de réflexion sur Gameboy Advance. Dans ce soft, vous dirigez un bâton qui est en rotation permanente sur lui-même à travers divers environnements semés d'embûches. Kuru Kuru Kururin demande au joueur de l'adresse, de la concentration et beaucoup de réflexes.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Kurukuru Kururin",
   "genre": "Action / Labyrinth",
   "synopsis": "Kuru Kuru Kururin is an innovative puzzle game in which the main character is inside a helicopter, and he must navigate himself through a maze in the least amount of time possible. Movements must be timed and precise, because if the helicopter's propeller hits a wall, 3 seconds is added to the timer. The protagonist's mission is to retrieve his brothers, who will join him after he finds them. He also finds many power-ups that will allow him to customize his helicopter's appearance.",
   "synopsis_lang": "en"
  }
 },

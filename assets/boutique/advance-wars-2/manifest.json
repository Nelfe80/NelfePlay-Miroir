 "text": {
  "fr": {
   "name": "Advance Wars 2 : Black Hole Rising",
   "genre": "Stratégie",
   "synopsis": "La suite du célèbre jeu tactique Advance Wars fait son retour sur Gameboy Advance avec Advance Wars 2 : Black Hole Advance. La menace de l'armée Black Hole pèse plus que jamais sur Wars World, et c'est devant l'imminence d'une invasion que les différentes forces vont devoir s'allier. Accomplissez l'objectif qui vous est fixé dans chaque mission, parfois avant un laps de temps donné. A vous de mettre en place la meilleure stratégie pour prendre l'avantage sur votre adversaire.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Advance Wars 2 : Black Hole Rising",
   "genre": "Strategy",
   "synopsis": "Just when you thought you'd seen the last of them, the Black Hole Army is storming back in this sequel to the award-winning Game Boy Advance strategy game. With new COs under his command, Sturm is leading a new invasion force, and it'll take advance strategy to stop him!",
   "synopsis_lang": "en"
  }
 },

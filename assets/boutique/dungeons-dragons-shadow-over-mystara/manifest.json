 "text": {
  "fr": {
   "name": "Dungeons & Dragons: Shadow over Mystara",
   "genre": "Beat'em All",
   "synopsis": "Dungeons and Dragons: Shadow over Mystara, (ou Shadow of Mystara, parfois même appelé Dungeons and Dragons 2), est un jeu vidéo du type beat them all avec des aspects jeu vidéo de rôle, développé et édité par Capcom en février 1996. C'est le second d'une série de deux jeux en arcade basés sur l'univers de Mystara (le premier volet de la saga s'intitule Dungeons and Dragons: Tower of Doom)1,2. Il est considéré comme le dernier et le plus grand des beat them all par Gaming Age Review3 et comme « un des plus réussis du genre » par Jon Thompson de All Games Guide",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Dungeons & Dragons: Shadow over Mystara",
   "genre": "Beat'em Up",
   "synopsis": "Dungeons & Dragons: Shadow over Mystara is an arcade game developed and published by Capcom in 1996 as a sequel to Dungeons & Dragons: Tower of Doom. It was also released on the Sega Saturn, packaged with Tower of Doom, under the title Dungeons & Dragons Collection. The game is set in the Dungeons & Dragons campaign setting of Mystara. It was one of the last 2-D arcade side-scrollers created by Capcom; only Battle Circuit (1997) came after Shadow over Mystara.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Pac-Man Battle Royale",
   "genre": "",
   "synopsis": "Pac-Man Battle Royale réinvente le classique en transformant le labyrinthe en une arène compétitive où jusqu'à quatre Pac-Man colorés s'affrontent pour être le dernier survivant. Le but n'est plus seulement de manger des pastilles, mais d'éliminer les adversaires en les avalant après avoir croqué une super pastille, tout en évitant les fantômes.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Pac-Man Battle Royale",
   "genre": "",
   "synopsis": "Pac-Man Battle Royale reinvents the classic by turning the maze into a competitive arena where up to four colored Pac-Men battle to be the last one standing. The goal is no longer just to eat dots, but to eliminate opponents by gobbling them up after eating a power pellet, while avoiding ghosts.",
   "synopsis_lang": "en"
  }
 },

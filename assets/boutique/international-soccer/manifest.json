  "fr": {
   "name": "International Soccer",
   "genre": "Sport / Football",
   "synopsis": "Ce jeu est pour 2 joueurs seulement. Dans cette version du football, chaque joueur contrôle 4 hommes, mais un seul à la fois. L'ordinateur déplace les 3 autres pour vous. Un gardien de but contrôlé par ordinateur aidera lorsqu'un but est tenté. Frappez le ballon pendant 90 minutes et essayez de marquer plus que votre adversaire.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "International Soccer",
   "genre": "Sports / Football (Soccer)",
   "synopsis": "This Game is 2-Player Only. In this version of soccer, each player controls 4 men, though only one at a time. The computer moves the other 3 for you. A computer-controlled goalie will help out when a goal attempt is made. Kick the ball around for 90 minutes, and try to score more than your opponent.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Golden Axe: The Revenge of Death Adder",
   "genre": "Beat'em All",
   "synopsis": "Death Adder est revenu et hante la région avec ses sbires. Heureusement quatre valeureux guerriers (un nain sur un géant, une centaure, un jeunot avec un trident et l'éternel guerrier en bleu du premier golden axe) vont s'imposer contre le tyran. A vous de choisir l'un d'entre eux et de vous frayer un chemin jusqu'à Death Adder et sa hache. Pour cela, vous disposez de divers coups d'épée et de crétures géantes (scorpions, mantes religieuses,...) pour hacher vos ennemis.\r\n\r\nAllez, et sauvez le monde!!",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Golden Axe: The Revenge of Death Adder",
   "genre": "Beat'em Up",
   "synopsis": "Like its legendary prequel, 1989's \"Golden Axe\"; 'Revenge' is sideways scrolling beat-em-up set in a traditional fantasy world, in which the evil 'Death Adder' has arisen to take over the lands. The game supports simultaneous four-player gameplay, with each player taking on one of the game's characters. The four available characters are 'Sternblade' (a barbarian warrior), 'Dora' (a female centaurian), 'Goah' (a giant with a dwarf sitting atop his shoulders) and 'Little Trix' (an agile, oriental-style warrior).",
   "synopsis_lang": "en"
  }
 },

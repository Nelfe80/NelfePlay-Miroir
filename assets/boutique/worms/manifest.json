 "text": {
  "fr": {
   "name": "Worms",
   "genre": "Stratégie",
   "synopsis": "Worms est un jeu de stratégie au tour par tour. Il met en scène jusqu'à 4 équipes de 4 vers, dont le but est de détruire les autres sur un terrain généré aléatoirement. Chaque ver dispose de 100 points de vie et meurt lorsque ses points de vie tombent à 0. À sa mort, un ver explose, causant des dégâts à tous ceux qui se trouvent à proximité.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Worms",
   "genre": "Strategy",
   "synopsis": "Worms is a turn-based strategy game. It features up to 4 teams of 4 worms, aiming to destroy the others on a generated terrain. Each worm has 100 hit points, and dies when his hit points fall to 0. Upon death, a worm explodes, causing damage to everyone around.nnnnnn",
   "synopsis_lang": "en"
  }
 },

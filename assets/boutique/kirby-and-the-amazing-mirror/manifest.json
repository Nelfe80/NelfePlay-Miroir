        "fr": {
            "name": "Kirby & the Amazing Mirror",
            "genre": "Plateforme",
            "synopsis": "Kirby and the Amazing Mirror est un jeu de plates-formes sur GBA. En plus de ses habituelles capacités (flotter dans l'air et aspirer ses ennemis), le petite boule rose possède désormais des pouvoirs angéliques qui lui donnent des ailes, un arc et des flèches, ainsi qu'un téléphone portable pour communiquer avec d'autres personnages du jeu.",
            "synopsis_lang": "fr"
        },
        "en": {
            "name": "Kirby & the Amazing Mirror",
            "genre": "Platform",
            "synopsis": "The Mirror World has been invaded by an evil shadow, and Kirby's got to save the day! Fortunately, he won't have to go it alone! He's been split into four Kirbys of different colors, and with his trusty cell phone, he can call up his colorful clones to lend a hand!",
            "synopsis_lang": "en"
        }
    },

 "text": {
  "fr": {
   "name": "Bubsy in : Claws Encounters of the Furred Kind",
   "genre": "Plateforme",
   "synopsis": "Dans ce jeu d'action de 15 niveaux, le joueur incarne Bubsy, le lynx roux, qui doit vaincre les Woolies, des extraterrestres qui volent des pelotes de laine. Le jeu se déroule dans cinq environnements différents, tels que la jungle, le Far West, etc., où le joueur doit sauter et atterrir sur ses ennemis pour les éliminer. À chaque fin de niveau, le joueur doit vaincre le boss, qui se trouve à l'intérieur d'un vaisseau extraterrestre.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Bubsy in : Claws Encounters of the Furred Kind",
   "genre": "Platform",
   "synopsis": "In this 15-level action game the player is Bubsy the bobcat, who has to defeat the Woolies the aliens, which steal balls of yarn. There are five different locations such as jungle, wild west, etc., where the player has to jump and land on their enemies to kill them. Each time to finish the level the player has to defeat the boss, who sits in an alien ship.",
   "synopsis_lang": "en"
  }
 },

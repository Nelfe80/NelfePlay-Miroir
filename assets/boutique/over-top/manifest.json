 "text": {
  "fr": {
   "name": "Over Top",
   "genre": "Course, Conduite / Course",
   "synopsis": "Over Top sur Neo Geo est un jeu de courses proposant 8 véhicules (Hummer, Ferrari, Moto...) qui s'affrontent dans des environnements divers (ville, désert, campagne...). L'objectif est de terminer les courses avant que le chronomètre n'atteigne zéro. Les virages sont annoncés par des flèches et le joueur peut s'aider d'un radar, notamment pour dénicher les raccourcis.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Over Top",
   "genre": "Racing, Driving / Racing",
   "synopsis": "In 1991, ADK (then Alpha team) released Thrash Rally for the Neo Geo. While fun to play, it was most noted for its woefully bad graphics. Five years later, ADK released another \"look-out-for-the-next-turn!\" game called Overtop. This time they got it almost all right: Great graphics, good sounds, lots of vehicles, and kept the excellent playability of its predecessor.",
   "synopsis_lang": "en"
  }
 },

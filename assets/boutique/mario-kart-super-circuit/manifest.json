 "text": {
  "fr": {
   "name": "Mario Kart : Super Circuit",
   "genre": "Course, Conduite",
   "synopsis": "Mario revient à fond les manettes dans le jeu de courses Mario Kart : Super Circuit sur Gameboy Advance. Vingt nouveaux circuits, des bonus classiques et des heures de courses sont au programme de ce soft. Le mode Grand Prix, le mode Bataille ainsi que la possibilité d'affronter vos amis sont également présents.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mario Kart : Super Circuit",
   "genre": "Racing, Driving",
   "synopsis": "All your favourite kart-racing characters are back and ready to kick it into high gear! 20 brand-new tracks await on Game Boy Advance, loaded with classic power-ups and primed for the type of frenzied racing that only Mario Kart: Super Circuit can deliver. It's time to burn rubber in the Grand Prix, challenge your pals, race your own ghost, clash in battle mode and feel the power in the palm of your hand!",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Psycho Soldier",
   "genre": "Plateforme",
   "synopsis": "Le personnage principal est une fille nommée Athéna. Elle tire des explosions d'énergie psychique comme arme principale. Elle peut collecter des orbes qu'elle peut contrôler par télépathie.\r\nCes orbes la protègent de certains projectiles et peuvent également être lancées sur des cibles. Les orbes exploseront à l'impact. Son compagnon, un garçon nommé Kensu, peut l'aider avec ses propres pouvoirs. Ensemble, ils nettoient une ville en ruine pleine de monstres et de mutants.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Psycho Soldier",
   "genre": "Platform",
   "synopsis": "Psycho Soldier is a side-scrolling shooter featuring two-player simultaneous play. \r\nThe major character is a girl named Athena. She fires blasts of psychic energy as her main weapon. She can collect orbs which she can control telepathically. \r\nThese orbs protect her from some projectiles and can also be launched at targets. The orbs will explode on impact. Her companion, a boy named Kensu, can help her with his own powers. Together they clean up a ruined city full of monsters and mutants.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Sonic Spinball",
   "genre": "Flipper",
   "synopsis": "Accompagné de son ami Tails, Sonic le hérisson bleu le plus rapide de la galaxie doit à nouveau affronter le Dr Robotnik dans Sonic Spinball sur Game Gear. Le quartier général ennemi est installé en haut d'un volcan, et le mécanisme qui le protège est similaire à celui d'un flipper. Mettez-vous en boule et escaladez le Mont Mobius pour libérer les animaux transformés en robots par votre pire ennemi.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Sonic Spinball",
   "genre": "Pinball",
   "synopsis": "The evil doctor Robotnik has a new plan to take over the world. He has built a new weapon, the Veg-O-Fortress on Mount Mobius and with it, he is transforming all creatures into robots. Sonic sneaks into the fortress and tries to stop Robotnik.\n\nUse Sonic as a pinball in 4 dangerous levels. Score points, get rings, collect Chaos Emeralds and destroy the boss at the end of each level.",
   "synopsis_lang": "en"
  }
 },

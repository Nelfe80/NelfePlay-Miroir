 "text": {
  "fr": {
   "name": "Berzerk",
   "genre": "Tir",
   "synopsis": "Le joueur contrôle un humanoïde dans des environnements labyrinthiques multi-tableaux en vue de dessus. Il doit progresser en éliminant une armée de robots belliqueux. C'est un précurseur du run and gun, qui a notamment influencé la conception de Robotron: 2084. Le jeu présente des caractéristiques innovantes de gameplay (notamment le tir multi-directionnel) et de réalisation avec des voix de synthèse.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Berzerk",
   "genre": "Shooter",
   "synopsis": "You are a prisoner on an alien planet that is made up of mazes. Robot gangs hunt you and you must shoot them before they hit you. Evil Otto, a grinning sinister face who is invincible, pursues you. If you can keep cool and not go bonkers, you'll eliminate robots, escape Evil Otto, and score big points.\r\n\r\nThe home video game version of a favorite Arcade game.",
   "synopsis_lang": "en"
  }
 },

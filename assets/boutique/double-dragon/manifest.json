 "text": {
  "fr": {
   "name": "Double Dragon",
   "genre": "Combat",
   "synopsis": "Double Dragon sur Neo Geo est un jeu de combat directement inspiré du célébrissime beat'em all éponyme de 1988. Cette fois ci, ce ne sont pas 2 mais 10 combattants jouables qui s'affrontent dans des duels en plein coeur des quartiers de New York.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Double Dragon",
   "genre": "Fighting",
   "synopsis": "Released around the same time as the film of the same name and loosely based on its story, this installment in the Double Dragon series also moves away from the traditional roam-the-streets-fighting to a pure one-on-one fighter. There are ten characters to choose from, including Billy and Jimmy and the game has colorful interactive backgrounds, screen zooming, over-the-top special moves and with the inclusion of double jumps, combos, charges for the losing player and counter hits, there is plenty of room for advanced fighting strategies.",
   "synopsis_lang": "en"
  }
 },

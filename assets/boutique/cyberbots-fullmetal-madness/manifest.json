  "fr": {
   "name": "Cyberbots : Fullmetal Madness",
   "genre": "Combat",
   "synopsis": "Le joueur a le choix d'incarner six différents pilotes pouvant contrôler l'un des douze mechas disponibles. Le but du jeu est d'affronter en duel d'autres robots. Chaque mecha dispose de coups spéciaux et d'une furie réalisable lorsque la jauge power est remplie.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Cyberbots : Fullmetal Madness",
   "genre": "Fighting",
   "synopsis": "Near the end of the 21st century, Earth begins to become overpopulated, leading to many people living in man-made space colonies. The primary army of Earth called \"Earth Corps\", has been conducting nefarious experiments and their work, along with the actions of the playable characters, will determine Earth's future.",
   "synopsis_lang": "en"
  }

 "text": {
  "fr": {
   "name": "Magical Drop III",
   "genre": "Puzzle-Game",
   "synopsis": "Dans Magical Drop III sur Neo Geo, vous contrôlez un clown qui attrape et lance des ballons. Vous devez les rassembler par couleurs identiques pour qu'ils explosent et libèrent de la place. Le mode deux joueurs vous permet d'affronter le CPU ou un ami, et cette fois-ci, vous pouvez choisir votre personnage, doté d'attaques qui lui sont propres.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Magical Drop III",
   "genre": "Puzzle",
   "synopsis": "This is the third installment in the puzzle frenzy series Magical Drop. In the game you control a clown who throws marbles up on the screen into the cluster of multi-colored marbles, rocks and crystals. The goal is to get three or more of the same color to remove marbles, but you can also grab more than one at the time to create long chain combos and gain better \"special\" blocks at the top of the screen.\n\nYou can play the game in single player modes or versus a friend in versus mode. In versus mode you get to pick your character, much like in a fighting game, each with their own counter attacks and abilities.\n\nFor the PSX version, the first Magical Drop was included on a separate disc.",
   "synopsis_lang": "en"
  }
 },

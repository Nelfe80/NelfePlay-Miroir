 "text": {
  "fr": {
   "name": "Basketball",
   "genre": "Sport / Basketball",
   "synopsis": "Basketball pour Atari VCS 2600 est un jeu de sport développé par Atari. Il permet au joueur de faire des matchs en un contre un face à l'ordinateur ou un autre joueur. Les matchs sont divisés en 2 mi-temps de 4 minutes. Le but est de marquer le plus de points et 2 niveaux de difficulté sont disponibles.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Basketball",
   "genre": "Sports / Basketball",
   "synopsis": "Basketball allows you to play a game of one-on-one against either the computer or another player. The court is viewed from the side with a basket at each end of the screen.  Using the joystick you can move your player around the court, dribble/shoot the ball, and attempt to block your opponent. The game is played in two 4 minute halves, and the player who scores the most points wins. There are two different skill levels available which can be set individually for each player.",
   "synopsis_lang": "en"
  }
 },

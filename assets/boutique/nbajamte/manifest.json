 "text": {
  "fr": {
   "name": "NBA Jam Tournament Edition",
   "genre": "Sport",
   "synopsis": "NBA Jam Tournament Edition est une version \"mise à jour\" de NBA Jam, sorti un an plus tôt. Se reposant sur la même base de gameplay arcade que son illustre aîné, cette nouvelle mouture propose néanmoins quelques nouveautés : un roster mis à jour, basé sur la saison 1994-1995 de la NBA, et quelques ajustements de gameplay; parmi lesquels : un rythme de jeu plus rapide, des équipes de 3 joueurs (au lieu de 2 dans le jeu précédent), de nouvelles caractéristiques propres à chaque joueur, l'apparition d'une jauge de fatigue, ainsi que la possibilité d'effectuer des remplacements à la mi-temps des matchs.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "NBA Jam Tournament Edition",
   "genre": "Sports",
   "synopsis": "An update of the classic 'NBA JAM'. New players, new features but still the same classic gameplay.",
   "synopsis_lang": "en"
  }
 },

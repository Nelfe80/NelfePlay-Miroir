 "text": {
  "fr": {
   "name": "Probotector",
   "genre": "Tir / Run and Gun",
   "synopsis": "Probotector est un jeu d'action sur Megadrive. Un terroriste s'est emparé d'une cellule de Red Falcon (les aliens les plus dangereux ayant jamais existé) et projette de les cloner ! Il ne tient qu'à vous de l'en empêcher et de détruire cette cellule avant qu'il ne soit trop tard. Jouable en solo, ou à deux dans un mode coopératif, Probotector vous propose de traverser plusieurs niveaux en éliminant un maximum d'ennemis grâce à vos puissantes armes à feu.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Contra : Hard Corps",
   "genre": "Shooter / Run and Gun",
   "synopsis": "While the original arcade games, as well as a few computer conversions under the Gryzor title, were released unchanged in Europe, subsequent console installments of the Contra were released under the Probotector title in Europe.",
   "synopsis_lang": "en"
  }
 },

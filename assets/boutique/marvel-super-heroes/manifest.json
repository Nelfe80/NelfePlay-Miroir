 "text": {
  "fr": {
   "name": "Marvel Super Heroes",
   "genre": "Combat",
   "synopsis": "Marvel Super Heroes est un jeu de combat en 2D des plus classiques. Retrouvez tous les super-héros Marvel tels que Psylocke, Wolverine, Juggernaut, Magneto, Captain America, Spider-Man, Iron Man, Hulk et bien d'autres encore pour vous taper dessus dans des combats acharnés. utilisez vos super-pouvoirs pour défaire vos ennemis.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Marvel Super Heroes",
   "genre": "Fighting",
   "synopsis": "Play as your favorite Marvel character: Wolverine, Spider-Man, The Incredible Hulk, Captain America, Iron Man, Psylocke, Shuma-Gorath, Blackheart, Juggernaut or Magneto. Power up with an Infinity Gem - Grant your super hero healing power, super attacks and increased strength.",
   "synopsis_lang": "en"
  }
 },

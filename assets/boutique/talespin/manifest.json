 "text": {
  "fr": {
   "name": "TaleSpin",
   "genre": "Plateforme",
   "synopsis": "Dans TaleSpin sur Megadrive, vous incarnez l'ours Baloo et devez l'aider à acheminer ses cargaisons. Le jeu alterne séquences de plates-formes et phases de pilotage aérien. Bravez les conditions climatiques, débarrassez-vous des pirates de l'air, mais surtout, prenez garde aux griffes acérées de Sher Khan !",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "TaleSpin",
   "genre": "Platform",
   "synopsis": "Baloo the Bear is the chief and only pilot at the always struggling air-frieght company of Higher for Hire. With his cargo plane, the Sea Duck and the young orphan, Kit Cloudkicker... Baloo is ready to take to the sky and face down air pirates, bad weather and the ruthless Shere Khan.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Breakers",
   "genre": "Combat",
   "synopsis": "Breakers sur Neo Geo est un jeu de combat 2D. Choisissez parmi 9 personnages ayant leur technique propre et tentez les \"chain\", capables de créer une pluie de coups et d'attaques incessantes. A noter que les combattants bénéficient de voix digitalisées.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Breakers",
   "genre": "Fighting",
   "synopsis": "In Breakers, choose one of eight fighters who have their own moves and special attacks. There are eight stages in the game, and each stage has two battles. The object of each battle is to drain your opponent's energy in order to win the battle. If there is a draw, a third battle takes place. If the time limit expires, the player with the less energy loses the battle. Once you have completed all eight stages, you will face a opponent that is much tougher than previous ones. Different endings and in-game dialog are viewed depending on the character that you select.",
   "synopsis_lang": "en"
  }
 },

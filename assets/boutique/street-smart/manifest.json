 "text": {
  "fr": {
   "name": "Street Smart",
   "genre": "Combat",
   "synopsis": "Le premier jeu de combat SNK, avant Fatal Fury, avant la Neo Geo!\r\n\r\nIci, pas de coup spéciaux, pas de choix de combattant, Street Smart est le summum de la simplicité!\r\n\r\nA découvrir.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Street Smart",
   "genre": "Fighting",
   "synopsis": "You begin by choosing one of 2 fighters (either a blond guy, or a dark haired guy in karate gear). Then you are whisked away to one of many cities on the map to have a battle. The opponents are tough, but simple. This game has no special moves (and has only punch, kick, and jump buttons), and all characters have insanely high energy. So you pretty much just wail away at each other with punches and kicks until someone falls down. An ambulance will show up to haul away your defeated opponent, and a girl in the audience will come out to congratulate you",
   "synopsis_lang": "en"
  }
 },

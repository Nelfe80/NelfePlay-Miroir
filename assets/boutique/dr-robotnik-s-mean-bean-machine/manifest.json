 "text": {
  "fr": {
   "name": "Dr. Robotnik's Mean Bean Machine",
   "genre": "Puzzle-Game",
   "synopsis": "Dr. Robotnik's Mean Bean Machine sur Game Gear est un puzzle-game où vous devez arranger des blocs de couleur de manière à les faire disparaître et à réaliser des enchaînements qui auront raison de votre opposant. Sauvez les habitants de BeanVille de la robotisation qu'Eggman veut leur faire subir !",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Dr. Robotnik's Mean Bean Machine",
   "genre": "Puzzle",
   "synopsis": "Okay, so this Dr. Robotnik guy, he decides to turn something else into robots.  This time, it's the citizens of Beanville!  It's up to you to save them from their doom.  You drop pairs of beans into the dungeons, trying to create groups of four in matching colors.  You must challenge Dr. Robotnik's robots to a battle and defeat them, and eventually face the Eggman himself.",
   "synopsis_lang": "en"
  }
 },

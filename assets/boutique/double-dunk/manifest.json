 "text": {
  "fr": {
   "name": "Double Dunk",
   "genre": "Sport / Basketball",
   "synopsis": "Jouez à un jeu rapide à deux contre deux sur un demi-terrain de basketball. N'utiliser que la moitié du terrain signifie que vous devez faire plus attention à ne pas perdre le ballon ou à manquer des coups faciles lorsqu'un adversaire est proche. Les tirs à 3 points et les fautes peuvent être activés ou désactivés. De plus, vous avez la possibilité de changer les couleurs des uniformes de chaque équipe.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Double Dunk",
   "genre": "Sports / Basketball",
   "synopsis": "Play a fast paced two-on-two game of half court basket ball. Using only half the court means you need to be more careful not to lose the ball, or to miss easy shots when an opponent is close. With multiple game styles and possible plays each game is something different. 3-point shots and fouls can be toggled on or off. Also, you have the option to change the colors of each team's uniforms.",
   "synopsis_lang": "en"
  }
 },

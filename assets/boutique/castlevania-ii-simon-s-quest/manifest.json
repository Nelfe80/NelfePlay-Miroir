 "text": {
  "fr": {
   "name": "Castlevania II : Simon's Quest",
   "genre": "Aventure",
   "synopsis": "Dans Castlevania II: Simon?s Quest sur NES, le célèbre chasseur de vampires Simon Belmont doit retrouver et détruire les restes de Dracula afin de lever la terrible malédiction qui pèse sur lui.Castlevania II reprend les éléments qui ont fait le succès de son prédécesseur, en y ajoutant un aspect aventure et une alternance entre le jour et la nuit. Méfiez-vous, les ennemis deviennent plus dangereux lorsque le soleil se couche!",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Castlevania II: Simon's Quest",
   "genre": "Adventure",
   "synopsis": "In Castlevania II: Simon?s Quest for NES, vampire hunter Simon Belmont must track down and destroy Dracula?s remains in order to save himself from a deadly curse.Castlevania II expands on its predecessor with the addition of new adventure elements and also a day and night system that means tougher enemies when the sun goes down!",
   "synopsis_lang": "en"
  }
 },

  "en": {
   "name": "Warriors of Fate",
   "genre": "Beat'em Up",
   "synopsis": "Warriors of Fate is a side-scrolling beat 'em up produced by Capcom, first released as a coin-operated arcade game in 1992 and later ported to the Sega Saturn and Sony PlayStation. It is Capcom's third game based on the Tenchi wo Kurau manga, following Dynasty Wars and Destiny of an Emperor.",
   "synopsis_lang": "en"

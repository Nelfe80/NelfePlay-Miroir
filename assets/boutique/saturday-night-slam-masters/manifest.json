 "text": {
  "fr": {
   "name": "Saturday Night Slam Masters",
   "genre": "Sport / Lutte",
   "synopsis": "Saturday Night Slam Masters est un jeu de combat se déroulant dans le monde du catch. Dix lutteurs peuvent être sélectionnés, chacun avec son style bien à lui et différentes combinaisons de boutons permettent d'amocher son adversaire. Il est possible de quitter le ring un court instant et de se servir d'éléments du décor comme armes. Un mode Death Match est également présent où tous les coups sont permis.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Saturday Night Slam Masters",
   "genre": "Sports / Wrestling",
   "synopsis": "A 1-on-1 fighting game in which players choose from 10 different wrestlers and take to the ring to try and defeat their larger-than-life opponents. Each wrestler has an assortment of moves, including his own special 'super slam'. The object of the game is to win and defend the championship by pinning or putting a submission hold on your opponent.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Gain Ground",
   "genre": "Tir",
   "synopsis": "Gain Ground est un shoot'em up à un ou deux joueurs, comportant des niveaux à écran unique, dans lequel le joueur doit sauver des soldats avant de s'échapper.\r\nLes joueurs peuvent choisir un personnage parmi trois, chacun avec ses propres armes, forces et faiblesses. Le temps est compté, et les soldats qui ne quittent pas le niveau sont perdus. Tous les soldats sauvés rejoignent les rangs du joueur en tant que vies bonus. Les niveaux comportent des plaines, châteaux, forêts, forts, etc.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Gain Ground",
   "genre": "Shooter",
   "synopsis": "Gain Ground is a one or two player shoot-em-up featuring single screen levels, in which players must rescue lost troops before making their way to the exit. Players can choose to play as any one of three different characters; each with their own unique weapons, strengths and weaknesses. Time is a factor in this game and all troops that do not enter the exit will be lost. All rescued troops will join the player's ranks as bonus players. The levels take players through fields, castles, forests, forts etc.",
   "synopsis_lang": "en"
  }
 },

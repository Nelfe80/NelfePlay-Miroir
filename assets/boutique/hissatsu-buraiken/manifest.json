  "fr": {
   "name": "Avengers",
   "genre": "Combat",
   "synopsis": "Avenger se déroule à Paradise City, où le méchant, \"Geshita\", a capturé six filles de la ville. L'objectif du joueur (Ryu ou Ko) est de bannir \"Geshita\" de Paradise City une fois pour toutes. Pendant le jeu, le joueur peut ramasser des bonus comme le \"Speed ??Up\", le Super Punch, les Grenades, les Shurikens, le Nunchaku et de la santé supplémentaire.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Avengers",
   "genre": "Fighting",
   "synopsis": "Avenger takes place in Paradise City, where the villain, \"Geshita\", has captured six girls from the city. The player's objective (as Ryu or Ko) is to banish \"Geshita\" from Paradise City once and for all. During the game, the player can pick up powerups like the \"Speed Up\", the Super Punch, Grenades, Shurikens, Nunchaku and extra health.",
   "synopsis_lang": "en"
  }
 },

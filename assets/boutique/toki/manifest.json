 "text": {
  "fr": {
   "name": "Toki",
   "genre": "Plateforme",
   "synopsis": "Si c'est pas malheureux ! Vous étiez tranquille avec votre petite amie puis tout à coup, un méchant arrive et l'enlève. Si ce n'était que ça, comme on dit, 1 de perdue 10 de retrouvées mais en plus, on vous transforme en singe cracheur de boules. Bizarre me direz-vous ? Hé bien, malgré une histoire loufoque, ce jeu de plates formes est une des légendes des jeux d'arcade. Quand on y a gouté, on ne peut plus s'en passer.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Toki",
   "genre": "Platform",
   "synopsis": "Toki features elements of tongue-in-cheek humor combined with the action. The player takes control of an enchanted ape who must battle hordes of jungle monsters with energy balls from his mouth (described humorously as \"monkey-spit\" or \"monkey-vomit\" by some gamers). The ultimate goal is to destroy the evil wizard who cast a spell on you; therefore transforming yourself from an ape back into a human, and rescuing the kidnapped princess. The game was ported to several video game consoles and home computers.",
   "synopsis_lang": "en"
  }
 },

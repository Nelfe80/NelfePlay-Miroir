 "text": {
  "fr": {
   "name": "Waterworld",
   "genre": "Aventure",
   "synopsis": "\"Waterworld est un jeu d'action inspiré du film avec Kevin Costner. Le joueur incarne ce dernier dans trois phases de jeu différentes. La première permet de diriger le bateau tout en se débarrassant des \"\"Smokers\"\". Une autre propose de nager sous l'eau pour ramasser divers bonus et éviter des créatures marines. La dernière est une phase d'action où plusieurs armes deviennent disponibles au fur et à mesure de la progression dans le jeu.\"",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Waterworld",
   "genre": "Adventure",
   "synopsis": "Waterworld is a platform action game developed by Ocean Software for the Sega Mega Drive, Sega 32X and Sega Saturn based upon the 1995 Waterworld film. The game was set for release in September 1995, but was cancelled for unknown reasons. Development for the game was completed, with releases for the SNES, PC, Game Boy and Virtual Boy.",
   "synopsis_lang": "en"
  }
 },

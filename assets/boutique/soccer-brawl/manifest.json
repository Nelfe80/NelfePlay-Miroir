 "text": {
  "fr": {
   "name": "Soccer Brawl",
   "genre": "Sport",
   "synopsis": "Soccer Brawl sur Neo Geo est jeu de football futuriste. La seule règle de ce sport est de marquer plus de buts que son adversaire. Tous les coups sont permis : il est possible d'électrocuter son adversaire et de lui tirer dessus pour récupérer la balle. En phase de possession, le joueur doit charger une barre d'énergie avant de décocher une imparable frappe au but .",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Soccer Brawl",
   "genre": "Sports",
   "synopsis": "The Cybernetic players use special kick shots and built-in arm phasers to destroy other players. Make sure your power meter is FULL when exercising these brutal tactics. Both stadiums, which are magnetically enclosed, enable you to kick or pass... off the wall! There are no fouls in this league, so watch your back or you'll get pulverized by the opposing team! You'll find here the most advanced sport in the world of soccer... SOCCER BRAWL!",
   "synopsis_lang": "en"
  }
 },

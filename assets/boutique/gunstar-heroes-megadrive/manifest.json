 "text": {
  "fr": {
   "name": "Gunstar Heroes",
   "genre": "Plateforme / Shooter Scrolling",
   "synopsis": "Le Colonel Red et l'armée de son empire ont décidé de voler la Gemme Mystique et de rendre plus puissant encore le Destructeur, un robot qui avait presque détruit la planète Gunstar, il y a 9 ans déjà. Les jumeaux Gunstar ont promis que, plus jamais, le Destructeur ne menacerait leur planète et maintenant, ils doivent passer à l'action! Etes-vous un héros, prêt à les suivre?",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Gunstar Heroes",
   "genre": "Platform / Shooter Scrolling",
   "synopsis": "Chaos has broken out on the planet Gunstar-9!!\n\nThe mad Colonel Red has discovered four crystals that imprison a deadly being known as GoldenSilver, and plans on unleashing it onto the population of the planet! He must be stopped! Enter...the Gunstar Heroes, Red and Blue!\n\nUnleash some mad blasting action onto the Colonel's army and don't let him bring GoldenSilver to life!! The fate of Gunstar-9 is in your hands!",
   "synopsis_lang": "en"
  }
 },

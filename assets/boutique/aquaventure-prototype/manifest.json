 "text": {
  "fr": {
   "name": "Aquaventure",
   "genre": "",
   "synopsis": "Vous êtes un plongeur, vous plongez au large des côtes de l'Alaska. Votre objectif est d'éviter les poissons mortels, de saisir les trésors cachés sous la surface et de revenir à la surface pour reprendre de l'air.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Aquaventure",
   "genre": "",
   "synopsis": "Aquaventure is a bit of a mystery in the prototype world. It was never mentioned in any Atari press releases nor does it show up on any internal part lists.  Aquaventure seems to have popped out of the woodwork one day without any public fanfare nor any history behind its mysterious origins.  In any case, Aquaventure seems to be complete and ready for release, we can only speculate as to why it was shelved.",
   "synopsis_lang": "en"
  }
 },

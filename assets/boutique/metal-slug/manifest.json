 "text": {
  "fr": {
   "name": "Metal Slug : Super Vehicle-001",
   "genre": "Tir / Run and Gun",
   "synopsis": "Metal Slug est un jeu d'action sur Neo Geo. Vous incarnez Marco Rossi et Tarma Roving, membres des Peregrine Falcons, en mission pour libérer de nombreux prisonniers. Face à vous, une horde d'ennemis qui veulent votre peau, et que vous devez donc annihiler, grâce notamment aux armes et véhicules que vous pouvez trouver en chemin.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Metal Slug : Super Vehicle-001",
   "genre": "Shooter / Run and Gun",
   "synopsis": "Metal Slug, originally released on the Neo Geo, is a side-scrolling shoot'em'up.\n\nThe player(s) takes the role of a soldier (or two) and fights a gigantic army. Every level consists of running forward blasting anything that moves, while collecting power-ups along the way (there's also a wide selection of weaponry in the game). In the end of each level the player goes up against one gigantic boss. \n\nThe PlayStation port introduces some extra features: there is a combat school where the player may fight with other players for the best time on each level and an art gallery.",
   "synopsis_lang": "en"
  }
 },

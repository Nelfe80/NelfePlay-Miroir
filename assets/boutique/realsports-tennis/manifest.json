 "text": {
  "fr": {
   "name": "RealSports Tennis",
   "genre": "Sport / Tennis",
   "synopsis": "Inscrivez votre nom en vedette sur le panneau de score du jeu RealSport Tennis!\r\nManiez la balle comme sur un vrai court de tennis; vous pouvez lancer dans les angles, taper un coup fort ou frapper une balle de lob bien haut dans les airs. Vous pouvez jouer à vitesse lente ou rapide contre un adversaire ou contre l'expert ordinateur lui-même.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "RealSports Tennis",
   "genre": "Sports / Tennis",
   "synopsis": "Realsports Tennis is a tennis game for two players or one player against the computer. The game follows standard tennis rules, and allows you to hit forehand or backhand shots to all areas of the court as well as serves and lobs. You can play a game of singles or doubles, and multiple skill levels are included.",
   "synopsis_lang": "en"
  }
 },

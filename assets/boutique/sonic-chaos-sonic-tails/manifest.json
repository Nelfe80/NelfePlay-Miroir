 "text": {
  "fr": {
   "name": "Sonic Chaos",
   "genre": "Plateforme",
   "synopsis": "Sonic Chaos vous permet pour la première fois sur Game Gear, d'incarner soit Tails, le renard à deux queues, soit le hérisson supersonique. La possibilité de voler ajoute une nouvelle dimension d'exploration à ce classique parmi les classiques du jeu de plates-formes.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Sonic Chaos",
   "genre": "Platform",
   "synopsis": "Here he comes, straight from his high-speed Sonic 2 adventure! Headstrong Sonic The Hedgehog and his feisty friend Tails blast into hyperspeed to save the Chaos Emeralds. If evil Dr. Robotnik snatches the emeralds first, he'll make a Super Bomb! Could this be the end?\r\nBe Sonic or Tails in an all-new quest. Roar through the zones with super attitude as Sonic! As Tails, spin your twin tails and fly high!\r\nBlast-astic action! Sonic soars with his new Rocket Shoes and Pogo Spring. Tails goes airborne for a dizzying sky ride to snag bonus items!\r\n6 zones, 18 levels of rollercoaster landscapes, corkscrewing speedways and wild, whirling thrills!",
   "synopsis_lang": "en"
  }
 },

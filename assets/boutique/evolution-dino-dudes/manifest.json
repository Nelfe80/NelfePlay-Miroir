 "text": {
  "fr": {
   "name": "Evolution : Dino Dudes",
   "genre": "Puzzle-Game",
   "synopsis": "Dans Evolution : Dino Dudes sur Jaguar, vous devez guider une tribu d'hommes préhistoriques dans leur évolution. A chaque niveau, vous devez accomplir des tâches en un temps limité avec un certain nombre de membres de la tribu. Des animations humoristiques entrecoupent les passages entre les niveaux. Vous dirigez les hommes un par un et pouvez leur demander de faire plusieurs actions différentes en fonction des objets à disposition.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Evolution : Dino Dudes",
   "genre": "Puzzle",
   "synopsis": "The gameplay of The Humans has similarities to Lode Runner and Lemmings. Your job in this action puzzler is to help prehistoric man to evolve by helping them discover tools, the wheel, weapons, or even fire. Each level in the game will have a given task to help in this, and you are allotted a number of characters who must accomplish the task. The player can switch from person to person while moving the characters around each scrolling puzzle, and teamwork is essential to success.",
   "synopsis_lang": "en"
  }
 },

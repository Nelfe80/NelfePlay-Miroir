 "text": {
  "fr": {
   "name": "Windjammers",
   "genre": "Sport",
   "synopsis": "Dans Windjammers sur Neo Geo, deux joueurs s'affrontent avec Frisbee dans des arènes closes. Chacun doit garder les trois buts derrière lui. Les parties sont limitées dans le temps. En cas d'égalité le match se termine grâce à la mort subite.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Windjammers",
   "genre": "Sports",
   "synopsis": "Windjammers is based on a real-life sport known as Saucer Tennis or Frisbee Tennis. You and an opponent face off in an arena with a low net in the middle. Points are scored by throwing a disc into the goals behind a player or whenever your opponent is not able to catch the disc in time. There are two moves: a regular throw and a lob. By using quarter-circle movement, you can also add effect to the throw. To catch difficult discs, you can slide to move more quickly. There are six characters to choose from, with specific abilities and their own court fit for their skills. A single game consists of short sets of thirty seconds. The game is won after two winning sets or sudden death after two draws.",
   "synopsis_lang": "en"
  }
 },

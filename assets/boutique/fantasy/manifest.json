 "text": {
  "fr": {
   "name": "Fantasy",
   "genre": "Action / Aventure",
   "synopsis": "Fantasy, développé par SNK et sorti en 1981 sur borne Rock‑Ola, est un jeu d'action‑aventure, connu pour être le premier à introduire un système de Continue, permettant au joueur de poursuivre l'histoire plutôt que de viser le scoring. \r\nLe titre se compose de dix tableaux narratifs, un record pour l'époque, retraçant la quête de Tom pour sauver Sherry, enlevée tour à tour par des pirates, un rapace, un aborigène puis un hélicoptère. \r\nChaque scène propose une mécanique différente : vol en montgolfière, combat sur un bateau, esquive d'ennemis, escalade d'un arbre géant, poursuite par un tigre ou fuite jusqu'au Tower Bridge. \r\nCette approche narrative marquera durablement l'évolution du “Continue” dans les jeux d'arcade.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Fantasy",
   "genre": "Action / Adventure",
   "synopsis": "You must rescue your girlfriend from the bad pirate who has stolen her from your island love nest. Then, rescue her from other kidnappers until you are reunited with her for good.",
   "synopsis_lang": "en"
  }
 },

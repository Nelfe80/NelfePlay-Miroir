 "text": {
  "fr": {
   "name": "Mega Man Battle Network 3 : White",
   "genre": "Jeu de rôles",
   "synopsis": "Le Dr. Wily est tenace et n'a certainement pas dit son dernier mot. Il projette de libérer un prototype d'internet placé sous le signe du mal. Pour cela, il doit mettre la main sur des codes d'accès. Lan et son double Mega Man comptent bien l'en empêcher en parcourant le code réseau et en combattant les virus qui s'y trouvent. Mega Man Battle Network 3 sur GBA est sorti en 2 éditions : Blue Version et White Version. Les quêtes annexes et les pouvoirs varient légèrement d'une version à l'autre.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mega Man Battle Network 3 : White Version",
   "genre": "Role Playing Game",
   "synopsis": "Join MegaMan.EXE, his operator Lan, and friends as they keep the net safe from viruses and cyber menaces. You'll travel through new virtual and real worlds, fight new bosses, interact with new characters, and even find new Battle Chips. It's cyber mayhem at its best!\r\n\r\nMega Man Battle Network 3 has two unique versions: Blue and White.  Each version contains unique Battle Chips, characters, and styles for MegaMan.EXE to use.",
   "synopsis_lang": "en"
  }
 },

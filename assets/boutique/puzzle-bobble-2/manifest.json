 "text": {
  "fr": {
   "name": "Puzzle Bobble 2",
   "genre": "Puzzle-Game / Lancer",
   "synopsis": "Dans Bust A Move 2 sur Neo Geo, vous devez faire disparaître toutes les billes en regroupant celles de même couleur, par groupe de 3 ou plus. Ce second opus intègre un mode deux joueurs dans lequel chaque joueur doit défier une intelligence artificielle de plus en plus coriace.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Bust-A-Move Again",
   "genre": "Puzzle / Throw",
   "synopsis": "Bub and Bob are back! Like in Tetris in reverse, you shoot bubbles at an array of different-colored bubbles stuck in an ever descending ceiling, attempting to match them up three by three to make them disappear. This edition contains both puzzle challenges, multiplayer and normal progressive stages.",
   "synopsis_lang": "en"
  }
 },

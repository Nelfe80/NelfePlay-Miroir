 "text": {
  "fr": {
   "name": "Fatal Run",
   "genre": "Course, Conduite",
   "synopsis": "Fatal Run est un jeu de course paru sur Atari VCS 2600. A bord d'un véhicule ultra-rapide, vous devez délivrer des médicaments dans les différentes villes d'un monde apocalyptique. Sur votre chemin, vous pouvez éliminer vos ennemis à l'aide d'armes variées et améliorer votre véhicule dans les différentes villes que vous traversez.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Fatal Run",
   "genre": "Racing, Driving",
   "synopsis": "In this post-apocalyptic driving/racing game you must travel to various towns delivering medicine, while on your way to a missile base which houses a rocket that can save the world.\n \nWhile driving through the 32 levels, you'll meet countless enemies who want to stop you from achieving your goal. Your car boasts many weapons to help you out, including dynamite, rockets, oil slicks, smoke screens, and machine guns. You can also upgrade your vehicle within the city shops. Upgrading your gas tank provides better mileage while upgrading your bumper protects you during collisions.\nA password feature let's you continue where you left off.",
   "synopsis_lang": "en"
  }
 },

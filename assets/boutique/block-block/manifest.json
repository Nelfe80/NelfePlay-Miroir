 "text": {
  "fr": {
   "name": "Block Block",
   "genre": "Action",
   "synopsis": "Une balle traverse l'écran et rebondit sur les parois supérieures et latérales de l'écran. Quand une brique est frappée, la balle rebondit et la brique est détruite. Le joueur perd un tour quand la balle touche le bas de l'écran. Pour éviter que cela ne se produise, le joueur a une barre mobile pour faire rebondir la balle vers le haut et la renvoyer dans le jeu.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Block Block",
   "genre": "Action",
   "synopsis": "A ball travels across the screen, bouncing off the top and side walls of the screen. When a brick is hit, the ball bounces away and the brick is destroyed. The player loses a turn when the ball touches the bottom of the screen. To prevent this from happening, the player has a movable paddle to bounce the ball upward and back into play.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Final Blow",
   "genre": "Sport",
   "synopsis": "Final Blow propose un championnat de boxe en une seule saison. Vous pouvez choisir parmi un groupe de combattants fictifs.\r\nLe jeu est essentiellement un jeu de boxe à défilement latéral où le joueur se déplace vers la gauche et la droite pour contrôler un boxeur. Lorsque le moment est opportun, le joueur peut déclencher un coup de poing final qui peut parfois mettre KO l'adversaire en une seule frappe.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Final Blow",
   "genre": "Sports",
   "synopsis": "Final Blow features a single season boxing championship run. You can select from a group of fictional fighters.\r\n\r\nThe game is essentially a side scrolling boxing game where the player moves left and right to control a boxer. When the timing is right, the player can unleash a final blow punch which can sometimes KO the opponent in a single strike.",
   "synopsis_lang": "en"
  }
 },

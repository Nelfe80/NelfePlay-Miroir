 "text": {
  "fr": {
   "name": "Sonic The Hedgehog",
   "genre": "Plateforme",
   "synopsis": "Franchissez le mur du son avec Sonic The Hedgehog (Sonic l'Hérisson). Crachez du feu avec la \"Formidable Attaque Supersonique\". Faites un looping en défiant la gravité. Vous pouvez même faire un tour de 360° sur vous-même dans un laboratoire circulaire. Vous n'avez jamais rien vu de tel!",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Sonic The Hedgehog",
   "genre": "Platform",
   "synopsis": "Sonic The Hedgehog breaks the limits of traditional video games with speed, style, and wild action. Blast through loops with the Super Sonic Spin Attack, launch through tunnels, and spin through 360-degree mazes. Gravity? Doesn't matter. Standing still? Not an option. This is a rush of speed you won't want to stop.",
   "synopsis_lang": "en"
  }
 },

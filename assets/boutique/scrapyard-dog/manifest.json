 "text": {
  "fr": {
   "name": "Scrapyard Dog",
   "genre": "Plateforme",
   "synopsis": "Dans Scrapyard Dog, vous jouez le rôle de Louie, un employé de la décharge, dont le compagnon Scraps a été reconnu par l'ignoble M. Big. Louie a des bombes et des bidons à sa disposition pour les utiliser contre les ennemis, qui comprennent des gangsters, des rats et des souris. Il peut également utiliser des boucliers pour se protéger en route vers les seize points de contrôle du jeu. Louie doit atteindre chaque point de contrôle dans un certain laps de temps afin de sauver Scraps.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Scrapyard Dog",
   "genre": "Platform",
   "synopsis": "In Scrapyard Dog you play the role of Louie, the junkyard guy, who's companion Scraps has been dognapped by the dastardly Mr. Big. Louie has bombs and cans at his disposal to use against the enemies, which include gangsters, rats, and mice. He can also use shields to protect himself on route to the sixteen checkpoints in the game. Louie must reach each checkpoint in a certain amount of time in order to save Scraps.",
   "synopsis_lang": "en"
  }
 },

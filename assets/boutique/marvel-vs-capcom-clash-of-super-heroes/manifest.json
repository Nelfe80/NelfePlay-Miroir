 "text": {
  "fr": {
   "name": "Marvel vs. Capcom : Clash of Super Heroes",
   "genre": "Combat",
   "synopsis": "Marvel vs. Capcom : Clash of the Super Heroes met aux prises les héros de l'éditeur de jeux Capcom et de l'éditeur de comics Marvel, dans un jeu de combat en 2D. Vous devez former une équipe de trois combattants, chacun pouvant intervenir à n'importe quel moment. Des enchaînements sont possibles entre les membres de votre équipe.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Marvel vs. Capcom : Clash of Super Heroes",
   "genre": "Fighting",
   "synopsis": "Marvel vs. Capcom: Clash of Super Heroes is the fifth Marvel Comics-licensed fighting game by Capcom and the third game in the Marvel vs. Capcom series. In contrast to X-Men vs. Street Fighter and Marvel Super Heroes vs. Street Fighter, the game features characters from numerous Capcom franchises such as Mega Man and Strider, rather than just Street Fighter characters. The game takes place within the Marvel comic continuity, as Professor Charles Xavier calls out for heroes to stop him before he merges with the consciousness of Magneto and becomes the being known as Onslaught, the final boss. The game was developed in late 1997 and first released in January 1998.",
   "synopsis_lang": "en"
  }
 },

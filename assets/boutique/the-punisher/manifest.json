 "text": {
  "fr": {
   "name": "The Punisher",
   "genre": "Beat'em All",
   "synopsis": "The Punisher est un beat them up mettant en scène le célèbre anti-héros de chez Marvel. Sorti sur CPS-1 en 1993, c'est le premier titre sous licence officielle développé par Capcom. Six niveaux de castagne et autres séquences de massacre vous attendent. Le Punisher va d'abord régler ses comptes avec le sinistre Bruno Costa, puis faire avorter un deal majeur de drogue, intercepter un gang puis devoir lutter contre le caid de la pègre, l'ignoble Kingpin; tout en croisant d'autres vilains de l'univers Marvel plus ou moins connus, tels que Bushwacker, Bone Breaker, ou encore Jigsaw. On saluera la réalisation du titre, qui respecte à la lettre l'esprit du comics et sa violence, très peu édulcorée pour l'époque. A noter qu'en mode 2 joueurs, c'est le personnage de Nick Fury, qui accompagnera Frank Castle dans sa quête de vengeance.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "The Punisher",
   "genre": "Beat'em Up",
   "synopsis": "A Capcom arcade beat-em-up game similar to games like Double Dragon featuring the Marvel character The Punisher. Nick Fury is also a playable character in this game.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Teenage Mutant Hero Turtles : Fall of the Foot Clan",
   "genre": "Plateforme",
   "synopsis": "Disponible sur Gameboy, Teenage Mutant Ninja Turtles : Fall of the Foot Clan retrace les aventures des mondialement connues Tortues Ninja. A travers 5 niveaux dans lesquels vous devrez résister aux assauts du Clan Foot, vous pourrez choisir la tortue de votre choix pour sauver April O'Neil enlevée par Shredder et Krang.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Teenage Mutant Ninja Turtles : Fall of the Foot Clan",
   "genre": "Platform",
   "synopsis": "The Turtles' first Game Boy game is a fairly simple platforming-style game, where Leonardo, Michaelangelo, Raphael, and Donatello must battle against Krang and Shredder and save their friend April O'Neil in the process.",
   "synopsis_lang": "en"
  }

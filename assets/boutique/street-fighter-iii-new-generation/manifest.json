 "text": {
  "fr": {
   "name": "Street Fighter III : New Generation",
   "genre": "Combat",
   "synopsis": "Street Fighter III: New Generation marque l'arrivée de nombreux changements et le début d'une nouvelle série Street Fighter. Les graphismes ont été entièrement refaits, dans un style moins « cartoon » que dans les jeux de la série Street Fighter Alpha, et la plupart des personnages sont nouveaux. L'animation des personnages est un des éléments les plus réussis du jeu.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Street Fighter III : New Generation",
   "genre": "Fighting",
   "synopsis": "A New Generation of Street Fighters! Features larger characters sprites than previous Street Fighter games with the smoothest, most detailed 2-D animation ever made at the time of its release, a level of quality that is yet to be matched by any other 2-D game outside of the Street Fighter III series as of 2004; some complain that too many things are animated and each animation contains too many frames, slowing down the pace of the game.",
   "synopsis_lang": "en"
  }
 },

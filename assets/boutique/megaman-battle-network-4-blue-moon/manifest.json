 "text": {
  "fr": {
   "name": "Mega Man Battle Network 4 : Blue Moon",
   "genre": "Jeu de rôles",
   "synopsis": "Comme son prédécesseur, Mega Man Battle Network 4 se décline en deux versions (Blue Moon et Red Sun) qui diffèrent légèrement l'une de l'autre dans les pouvoirs acquis ou l'ordre des événements. Dans ce jeu de rôle, Lan et Mega Man trouvent des Dark Chips qui altèrent grandement l'esprit de celui qui les porte. Le héros lui-même peut tomber du côté obscur à cause de ces modules maléfiques.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mega Man Battle Network 4 : Blue Moon",
   "genre": "Role Playing Game",
   "synopsis": "The fourth installment in the Mega Man Battle Network series comes in two versions--Red Sun and Blue Moon--each with different enemies, battle chips, souls, and characters. Once again, you assume the role of Lan as he and his friend, Mega Man.exe, fight to rid the Internet of viruses and other cyberworld enemies. Unlike previous games in the series, Mega Man Battle Network 4 focuses on a tournament system where players encounter a variety of enemies that must be defeated. A new Soul Unison system lets Mega Man transform into his defeated enemies.",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Marvel vs. Capcom 2: New Age of Heroes",
   "genre": "Combat / Versus",
   "synopsis": "Suite de Marvel vs. Capcom: Clash of Super Heroes .Le gameplay est  très similaire à celui du précédent volet. Et comme son prédécesseur, ce n'est pas le jeu le plus équilibré au monde, mais cela ne l'empêche pas d'être très amusant.Le style graphique du jeu a été mis à jour . Alors que les personnages sont encore composées de sprites 2D, les fonds sont en 3D, plein de mouvement et de couleurs vives.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Marvel vs. Capcom 2: New Age of Heroes",
   "genre": "Fighting / Versus",
   "synopsis": "The best of the best are back! Fight with 28 characters and unlock 28 extra fighters on 3 on 3 tag battles. Learn to master the new 'Delayed hyper combo system' to combine your 3 characters hyper moves and defeat the mighty Abyss.",
   "synopsis_lang": "en"
  }
 },

 "text": {
  "fr": {
   "name": "Sonic Advance 3",
   "genre": "Plateforme",
   "synopsis": "Sonic Advance 3 est un jeu de plates-formes 2D disponible sur Gameboy Advance. Dans cette opus, le joueur a la possibilité de choisir son personnage ainsi que son coéquipier. Selon la combinaison, les conséquences sont différentes. Sonic peut propulser à toute vitesse son coéquipier, Tails le lance en l'air, Amy lui donne un marteau, etc. A vous de bien savoir exploiter vos personnages afin de terminer les niveaux.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Sonic Advance 3",
   "genre": "Platform",
   "synopsis": "Eggman has broken the world into seven parts, now the player must find the seven Chaos Emeralds to restore the world. \n\nSonic Advance 3 is a Sonic game with a twist: the player can play with a friend in co-op mode or one of many multi-player modes like ring race. The game contains features from Sonic Advance and Sonic Advance 2, but with more options like choosing from 2 characters in story mode (a leading and a following character).",
   "synopsis_lang": "en"
  }
 },

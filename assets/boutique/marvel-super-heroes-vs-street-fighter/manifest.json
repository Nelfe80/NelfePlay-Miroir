 "text": {
  "fr": {
   "name": "Marvel Super Heroes vs. Street Fighter",
   "genre": "Combat",
   "synopsis": "Marvel Super Heroes Vs Street Fighter est un jeu de combat. Comme son nom l'indique, ce jeu va mettre aux prises les habituels personnages de Street Fighter avec les célèbres héros des Marvel Comics. Vous allez donc pouvoir organiser des combats entre Spiderman et Ryu, Hulk et Dhalsim ou encore Captain America contre Ken. Soit au total 17 personnages accessibles dès le départ du jeu, 9 provenant du monde de Street Fighter et 8 personnages des Marvel Comics.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Marvel Super Heroes vs. Street Fighter",
   "genre": "Fighting",
   "synopsis": "The second entry in the Marvel Vs. Capcom series, pitting fan favorites from Street Fighter and Marvel heroes against each other!\r\nSpider-Man, Hulk, Captain America and more join the X-Men to team up with and against characters from Street Fighter, now able to use Cross-Over Assists!",
   "synopsis_lang": "en"
  }
 },

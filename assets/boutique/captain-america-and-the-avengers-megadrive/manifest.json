 "text": {
  "fr": {
   "name": "Captain America and the Avengers",
   "genre": "Beat'em All",
   "synopsis": "Captain America and the Avengers sur Megadrive est la conversion du jeu d'action sorti en arcade. Incarnez les héros Marvel tels qu'Iron Man, Hawkeye et Vision. Vous pouvez choisir de jouer seul ou à deux simultanément, pour éliminer tout opposant qui osera se mettre en travers de votre super-chemin.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Captain America and the Avengers",
   "genre": "Beat'em Up",
   "synopsis": "A conversion of the arcade game of the same name, Captain America and The Avengers is a one or two player (simultaneous) side-scrolling beat 'em up in which four Marvel Comics licensed heroes (Captain America, Iron Man, Hawkeye and Vision) take on the evil Red Skull (who \"by assembling a team of super-villains seeks to conquer the world\"). Isn't that always the way?",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Turbo Sub",
   "genre": "Shoot'em Up",
   "synopsis": "Turbo Sub est un shoot'em up sorti sur Lynx. La Terre est à nouveau envahie, et cette fois-ci peut-être par des poissons aliens mutants car c'est à bord de votre sous-marin surpuissant que vous devrez les affronter.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Turbo Sub",
   "genre": "Shoot'em Up",
   "synopsis": "Turbo Sub released in 1985 as an arcade shooter game by Entertainment Sciences. Then later in 1991 for the Atari Lynx. The arcade version was a one player game set in the future where you control a submersible ship against a horde of aliens. The Atari Lynx version is the same but can be played with two players and tells us the story is set in the 28th century on Earth. The planet has been invaded and the goal of the game is that the player must destroy all the aliens.",
   "synopsis_lang": "en"
  }
 },

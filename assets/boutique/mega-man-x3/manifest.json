 "text": {
  "fr": {
   "name": "Mega Man X3",
   "genre": "Plateforme / Shooter Scrolling",
   "synopsis": "Après la défaite des Mavericks dans les épisodes précédents, les robots vivent en paix avec les humains. Mais les Mavericks d'origine reviennent à la charge et menacent l'équilibre. Mega Man et Zero sont rappelés sur le devant de la scène pour contrer la nouvelle attaque. Mega Man X3 sur Super Nes propose 8 niveaux d'action plates-formes qui conduisent tous vers un boss différent à affronter.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Mega Man X3",
   "genre": "Platform / Shooter Scrolling",
   "synopsis": "A Reploid scientist named Dr. Doppler begins creation of a new city for Reploids, which will bring a new era of peace to the Reploids and humans. But something goes terribly wrong, and now Mavericks have begun to appear everywhere! It's up to X and Zero to find out who is behind this Maverick revolt and bring them down for good!",
   "synopsis_lang": "en"
  }
 },

  "fr": {
   "name": "Kid Dracula",
   "genre": "Plateforme",
   "synopsis": "Kid Dracula sur Gameboy vous met dans la peau d'un vampire qui est pote avec la mort. Dans un jeu de plates-formes, vous traversez 8 niveaux dans lesquels vous pouvez apprendre des sorts comme la classique transformation en chauve-souris.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "Kid Dracula",
   "genre": "Platform",
   "synopsis": "Kid Dracula is a side-scroller and a parody of the Castlevania series. The difference is you play as a young vampire rather than a vampire killer.\n\nGameplay consists of very standard jump and shoot platform action.  As you progress through the 8 levels, you gain the ability to perform spells, like turning into a bat. You will also receive guidance from your pal, the Grim Reaper.",
   "synopsis_lang": "en"
  }
 },

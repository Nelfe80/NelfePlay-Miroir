  "fr": {
   "name": "RealSports Football",
   "genre": "Sport / Football Américain",
   "synopsis": "RealSports Football est une simulation de football à un ou deux joueurs qui se joue sur un terrain avec défilement horizontal, avec cinq joueurs dans chaque équipe. Comme dans le vrai football, l'objectif est de parcourir un terrain de 100 mètres en combinant jeux de passes et de courses.",
   "synopsis_lang": "fr"
  },
  "en": {
   "name": "RealSports Football",
   "genre": "Sports / Football (American)",
   "synopsis": "RealSports Football is a one or two-player football simulation played on a horizontal scrolling field, with five players on each team. As in real football, the goal is to march down a 100-yard field using a combination of passing and running plays. There are three ways to score: crossing the defensive team's goal line is a touchdown worth seven points, kicking the ball through the defense's goal post is a field goal worth three points, and tackling the ball carrier inside the end zone is a safety worth two points.",
   "synopsis_lang": "en"
  }
 },
